# Get your API key at https://moondev.com
MOONDEV_API_KEY=your_api_key_here

# Optional -- powers hourly new-hypothesis generation. Without it the loop
# still runs, it just never proposes new parameterizations.
# Get a key at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_key_here

# Optional -- posts each cycle's summary to Discord. Without it the loop
# still runs, it just doesn't post anywhere.
# Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
